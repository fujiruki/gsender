{
  "id": "com.fujiruki.operator",
  "name": "オペレーター Plugin",
  "description": "日常のCNC操作(原点保存・復元、起動シーケンス、プローブ、安全チェックリスト、ルーチンモード)を標準化し、パート作業者を含め誰でも安全にマシンを操作できるようにするPluginです。",
  "version": "0.1.0",
  "engine": ">=1.6.0",
  "ui": {
    "entry": "ui/index.html",
    "contributions": [
      {
        "slot": "tools-page",
        "route": "operator-plugin",
        "label": "オペレーター"
      }
    ]
  },
  "parsers": [
    {
      "id": "probe",
      "label": "プローブ結果",
      "mode": "line",
      "match": {
        "source": "^\\[PRB:(?<x>[-\\d.]+),(?<y>[-\\d.]+),(?<z>[-\\d.]+)(?:,[-\\d.]+)*:(?<ok>[01])\\]$"
      }
    }
  ],
  "permissions": [
    "machine:read",
    "machine:write",
    "machine:parse",
    "machine:query",
    "machine:command",
    "redux:read",
    "storage"
  ],
  "capabilities": {
    "requestTypes": [
      "machine:get:context",
      "machine:command",
      "machine:query",
      "machine:busy:set",
      "redux:get:state",
      "storage:get",
      "storage:set",
      "storage:delete",
      "storage:get:all",
      "storage:set:all",
      "storage:clear"
    ],
    "topics": ["redux", "controller", "parser"],
    "allowedFunctions": ["machine", "getSelector", "storage"]
  }
}
